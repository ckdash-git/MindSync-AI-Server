# ============================================
# MindSync AI Server — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=15s

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=mindsync
DB_PASSWORD=changeme_db_password
DB_NAME=mindsync
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# --- JWT ---
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# --- Encryption (AES-256 Key Rotation) ---
# Keys must be exactly 32 bytes (hex-encoded = 64 chars)
ENCRYPTION_KEY_V1=changeme_64_hex_chars_representing_32_bytes_key_v1
ENCRYPTION_KEY_CURRENT=v1

# --- OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
OPENROUTER_TIMEOUT=120s
OPENROUTER_MAX_RETRIES=3

# --- Privacy ---
PRIVACY_MODE=standard
# Options: standard, strict

# --- Rate Limiting ---
RATE_LIMIT_AUTH_RPM=5
RATE_LIMIT_CHAT_RPM=60
RATE_LIMIT_STREAM_RPM=10

# --- Request Timeout ---
REQUEST_TIMEOUT_DEFAULT=30s
REQUEST_TIMEOUT_STREAM=120s

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

# --- Logging ---
LOG_LEVEL=debug
# Options: debug, info, warn, error
